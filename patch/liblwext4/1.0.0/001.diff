+ * THIS SOFTWARE IS PROVIDED BY THE AUTHOR ``AS IS'' AND ANY EXPRESS OR
+ * IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES
+ * OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.
+ * IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT,
+ * INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT
+ * NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF
+ * THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+// stuff for open, close, read, write
+#include <unistd.h>
+#include <fcntl.h>
+// generic stuff
+#include <string.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+
+// library specific stuff
+#include <ext4_config.h>
+#include <ext4_blockdev.h>
+#include <ext4_errno.h>
+
+// local stuff
+#include "blockdev.h"
+
+/**********************BLOCKDEV INTERFACE**************************************/
+static int blockdev_open( struct ext4_blockdev* bdev );
+static int blockdev_bread( struct ext4_blockdev* bdev, void* buf, uint64_t blk_id, uint32_t blk_cnt );
+static int blockdev_bwrite( struct ext4_blockdev* bdev, const void* buf, uint64_t blk_id, uint32_t blk_cnt );
+static int blockdev_close( struct ext4_blockdev* bdev );
+static int blockdev_lock( struct ext4_blockdev* bdev );
+static int blockdev_unlock( struct ext4_blockdev* bdev );
+
+/******************************************************************************/
+
+static int blockdev_get_handle( struct ext4_blockdev* bdev ) {
+  int* handle = ( int* )bdev->bdif->p_user;
+  return *handle;
+}
+
+static void blockdev_set_handle( struct ext4_blockdev* bdev, int new_handle ) {
+  int* handle = ( int* )bdev->bdif->p_user;
+  *handle = new_handle;
+}
+
+/******************************************************************************/
+static int blockdev_open( struct ext4_blockdev* bdev ) {
+  // handle not yet set
+  if ( !bdev->bdif->fname ) {
+    return ENODATA;
+  }
+  // fetch stat information
+  struct stat st;
+  if ( -1 == stat( bdev->bdif->fname, &st ) ) {
+    return EIO;
+  }
+  // open file
+  int dev_file = open( bdev->bdif->fname, O_RDWR );
+  if ( -1 == dev_file ) {
+    return EIO;
+  }
+  // populate bunch of information from stat result
+  bdev->part_size = ( uint32_t )st.st_size;
+  bdev->bdif->ph_bcnt = bdev->part_size / bdev->bdif->ph_bsize;
+  // allocate space for file dscriptor
+  bdev->bdif->p_user = malloc( sizeof( int ) );
+  if ( ! bdev->bdif->p_user ) {
+    close( dev_file );
+    return EIO;
+  }
+  // set handle
+  blockdev_set_handle( bdev, dev_file );
+  // return success
+  return EOK;
+}
+
+/******************************************************************************/
+
+static int blockdev_bread(
+  struct ext4_blockdev* bdev,
+  void* buf,
+  uint64_t blk_id,
+  uint32_t blk_cnt
+) {
+  // calculate size and offset
+  size_t size = bdev->bdif->ph_bsize * blk_cnt;
+  off_t offset = ( off_t )blk_id * ( off_t )bdev->bdif->ph_bsize;
+  // read from device
+  ssize_t result = pread( blockdev_get_handle( bdev ), buf, size, offset );
+  // handle error
+  if ( -1 == result || ( size_t )result != size ) {
+    return EIO;
+  }
+  // return success
+  return EOK;
+}
+
+
+/******************************************************************************/
+static int blockdev_bwrite(
+  struct ext4_blockdev* bdev,
+  const void* buf,
+  uint64_t blk_id,
+  uint32_t blk_cnt
+) {
+  // calculate size and offset
+  size_t size = bdev->bdif->ph_bsize * blk_cnt;
+  off_t offset = ( off_t )blk_id * ( off_t )bdev->bdif->ph_bsize;
+  // read from device
+  ssize_t result = pwrite( blockdev_get_handle( bdev ), buf, size, offset );
+  // handle error
+  if ( -1 == result || ( size_t )result != size ) {
+    return EIO;
+  }
+  // return success
+  return EOK;
+}
+/******************************************************************************/
+static int blockdev_close( struct ext4_blockdev* bdev ) {
+  int fd = blockdev_get_handle( bdev );
+  if ( fd ) {
+    close( fd );
+  }
+  return EOK;
+}
+
+static int blockdev_lock( __unused struct ext4_blockdev* bdev ) {
+  // FIXME: ADD LOGIC
+  return EOK;
+}
+
+static int blockdev_unlock( __unused struct ext4_blockdev* bdev ) {
+  // FIXME: ADD LOGIC
+  return EOK;
+}
+
+/******************************************************************************/
+struct ext4_blockdev* ext4_blockdev_get( void ) {
+  // allocate block device
+  struct ext4_blockdev* bdev = malloc( sizeof( *bdev ) );
+  // handle error
+  if ( ! bdev ) {
+    return NULL;
+  }
+  // allocate substructure
+  struct ext4_blockdev_iface* bdif = malloc( sizeof( *bdif ) );
+  // handle error
+  if ( ! bdif ) {
+    free( bdev );
+    return NULL;
+  }
+  // allocate buffer
+  uint8_t* buffer = malloc( sizeof( *buffer ) * 512 );
+  // handle error
+  if ( ! buffer ) {
+    free( bdif );
+    free( bdev );
+    return NULL;
+  }
+  // clear memory
+  memset( bdev, 0, sizeof( *bdev ) );
+  memset( bdif, 0, sizeof( *bdif ) );
+  memset( buffer, 0, sizeof( *buffer ) * 512 );
+  // populate interface
+  bdif->open = blockdev_open;
+  bdif->bread = blockdev_bread;
+  bdif->bwrite = blockdev_bwrite;
+  bdif->close = blockdev_close;
+  bdif->lock = blockdev_lock;
+  bdif->unlock = blockdev_unlock;
+  bdif->ph_bsize = 512;
+  bdif->ph_bcnt = 0;
+  bdif->ph_bbuf = buffer;
+  // populate device
+  bdev->bdif = bdif;
+  bdev->part_offset = 0;
+  bdev->part_size = 0;
+  bdev->bdif->p_user = NULL;
+  // return device
+  return bdev;
+}
+/******************************************************************************/
+int ext4_blockdev_name_set( struct ext4_blockdev* bdev, const char* name ) {
+  // duplicate name into temporary
+  const char* tmp = strdup( name );
+  // handle error
+  if ( ! tmp ) {
+    return ENOMEM;
+  }
+  // free name if set
+  if ( bdev->bdif->fname ) {
+    free( ( void* )bdev->bdif->fname );
+  }
+  // overwrite fname with temporary
+  bdev->bdif->fname = tmp;
+  // return success
+  return EOK;
+}
+/******************************************************************************/
